# =============================================================================
# Khan Parcel — Environment Variables
# Copy to .env and fill in real values before running.
# =============================================================================

# ---------- Django ----------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.dev

# ---------- Database (PostGIS) ----------
POSTGRES_DB=khanparcel
POSTGRES_USER=khanparcel
POSTGRES_PASSWORD=khanparcel_secret
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
REDIS_CELERY_URL=redis://redis:6379/2

# ---------- Celery ----------
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=django-db

# ---------- JWT ----------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# ---------- OTP ----------
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# ---------- SMS / Twilio ----------
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- Firebase (FCM push) ----------
FIREBASE_CREDENTIALS_PATH=
FCM_ENABLED=False

# ---------- Storage (S3 / MinIO) ----------
STORAGE_BACKEND=minio
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=khanparcel-media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_USE_SSL=False

# ---------- Routing / Maps ----------
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=http://osrm:5000
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# ---------- Dispatch ----------
DISPATCH_MAX_ROUNDS=4
DISPATCH_RADII_KM=2,4,7,10
DISPATCH_OFFER_TTL_SECONDS=15
DISPATCH_SCORE_W1=0.35
DISPATCH_SCORE_W2=0.20
DISPATCH_SCORE_W3=0.15
DISPATCH_SCORE_W4=0.10
DISPATCH_SCORE_W5=0.10
DISPATCH_SCORE_W6=0.10

# ---------- Geofence ----------
GEOFENCE_RADIUS_METERS=150

# ---------- Surge ----------
SURGE_RECALC_INTERVAL_SECONDS=60
SURGE_MAX_MULTIPLIER=2.5
SURGE_H3_RESOLUTION=8
SURGE_EMA_ALPHA=0.3

# ---------- Pricing ----------
QUOTE_EXPIRY_SECONDS=300
QUOTE_SURGE_DRIFT_THRESHOLD=0.10

# ---------- Email (MailHog in dev) ----------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_USE_TLS=False

# ---------- Sentry ----------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ---------- Seed Data ----------
SEED_CENTER_LAT=33.6844
SEED_CENTER_LNG=73.0479
SEED_NUM_RIDERS=50
SEED_NUM_ORDERS=200

# ---------- Staff 2FA ----------
TOTP_ISSUER=KhanParcel
